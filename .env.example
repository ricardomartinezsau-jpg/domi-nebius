# Copia a .env.local para desarrollo. Nunca commitees valores reales.

# Inferencia y huellas numéricas: Nebius Token Factory (https://tokenfactory.nebius.com).
NEBIUS_API_KEY=

# Base de datos PostgreSQL con la extensión pgvector.
DATABASE_URL=postgresql://user:password@localhost:5432/domi
# Ponlo en "require" solo si la base NO está en la misma red privada que la app.
DATABASE_SSL=

# Cuentas: secreto aleatorio de 32+ caracteres y el origen HTTPS real en producción.
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000

# Admisión de trabajo pagado: cerrada por defecto. Habilitar solo después de
# validar/aplicar la migración 0007 y coordinar web + workers. Ver BACKEND_REMEDIATION.md.
DOMI_ADMISSION_ENABLED=false

# Búsqueda viva para anclar los micro-pasos en cómo se hacen las cosas hoy.
LINKUP_API_KEY=

# Ejecucion de la investigacion en Render Workflows. Se saca en Render:
# Account Settings -> API Keys. En produccion va tambien en las variables del
# servicio desplegado, no solo aqui.
RENDER_API_KEY=

# Modelo para los pasos de investigacion (prompts largos). Medido: ver AGENTS.md.
NEBIUS_RESEARCH_MODEL=

# Identificador del servicio de Render Workflows. Por defecto: domi-research.
RENDER_WORKFLOW_SLUG=

# Only for the live Render recovery demo. Set these on the WEB service only.
# The token is sent once as the operator-only X-Domi-Demo-Fault-Token header;
# never add it to the browser client or a public request body. The resulting
# per-run marker is what the workflow uses. Remove the switch after the demo.
DOMI_DEMO_FAULT_ENABLED=false
DOMI_DEMO_FAULT_TOKEN=
